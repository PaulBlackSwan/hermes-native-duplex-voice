--- /dev/null
+++ b/apps/desktop/src/i18n/live-voice-copy.test.ts
@@ -0,0 +1,42 @@
+import { describe, expect, it } from 'vitest'
+
+import { fieldCopyForSchemaKey } from '@/app/settings/field-copy'
+
+import { BUNDLED_LOCALES, TRANSLATIONS } from './catalog'
+
+const fields = ['voice.live_provider', 'voice.grok_live.voice', 'voice.grok_live.instructions']
+
+describe('native Live Voice settings copy', () => {
+  it.each(BUNDLED_LOCALES)('%s resolves provider and Grok field copy without a fallback', locale => {
+    const { fieldLabels, fieldDescriptions } = TRANSLATIONS[locale].settings
+
+    for (const key of fields) {
+      expect(fieldCopyForSchemaKey(fieldLabels, key), `${locale}: label for ${key}`).toBeTruthy()
+      expect(fieldCopyForSchemaKey(fieldDescriptions, key), `${locale}: description for ${key}`).toBeTruthy()
+
+      if (locale !== 'en') {
+        expect(fieldCopyForSchemaKey(fieldLabels, key)).not.toBe(
+          fieldCopyForSchemaKey(TRANSLATIONS.en.settings.fieldLabels, key)
+        )
+        expect(fieldCopyForSchemaKey(fieldDescriptions, key)).not.toBe(
+          fieldCopyForSchemaKey(TRANSLATIONS.en.settings.fieldDescriptions, key)
+        )
+      }
+    }
+
+    const mode = fieldCopyForSchemaKey(fieldDescriptions, 'voice.voice_chat_mode')!
+
+    for (const term of ['chained', 'gpt-live', 'OpenAI', 'API', 'Grok', 'OAuth', 'Hermes']) {
+      expect(mode, `${locale}: mode explains ${term}`).toContain(term)
+    }
+
+    expect(mode).not.toMatch(/0[.,]05|\$0/)
+    const provider = fieldCopyForSchemaKey(fieldDescriptions, 'voice.live_provider')!
+
+    for (const term of ['OpenAI', 'API', 'Grok', 'OAuth']) {
+      expect(provider).toContain(term)
+    }
+
+    expect(fieldCopyForSchemaKey(fieldDescriptions, 'voice.grok_live.instructions')).toContain('Hermes')
+  })
+})
