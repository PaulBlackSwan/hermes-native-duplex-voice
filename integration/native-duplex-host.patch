+// @vitest-environment node
+import { createRequire } from 'node:module'
+
+import { afterEach, expect, test, vi } from 'vitest'
+
+import { createGrokBridge } from '@/lib/voice-grok-bridge'
+import { captureNativeGateway } from '@/store/gateway-native-transport'
+import { createNativeLiveSession, registerNativeLiveProvider } from '@/store/native-live-providers'
+
+import { CANONICAL_GATEWAY_PROTOCOL } from './canonical-protocol'
+import { HermesGateway } from './client'
+
+const owner = { connectionId: 'fixture-connection', profile: 'writer' }
+const scope = { owner, sessionId: 'voice-session' }
+
+const tick = async () => {
+  for (let i = 0; i < 20; i++) {
+    await Promise.resolve()
+  }
+}
+
+afterEach(() => vi.unstubAllGlobals())
+
+// Only the network boundary is synthetic. The production HermesGateway, canonical adapter,
+// capture/lease and Grok bridge are used, including the real private-ticket socket factory.
+async function wire() {
+  const wsPackage = 'ws'
+  const { WebSocketServer } = await import(wsPackage)
+  const handshakes: Array<{ url: string; protocols: string }> = []
+  const consumed = new Set<string>()
+
+  const server = new WebSocketServer({
+    host: '127.0.0.1',
+    port: 0,
+    verifyClient(info: any) {
+      const protocols = String(info.req.headers['sec-websocket-protocol'] ?? '')
+      const url = String(info.req.url)
+      handshakes.push({ url, protocols })
+      const offered = protocols.split(',').map(value => value.trim())
+      const ticket = offered.find(value => value.startsWith('hermes-gateway-ticket.'))
+
+      if (
+        new URL(url, 'http://fixture').searchParams.has('ticket') ||
+        !offered.includes(CANONICAL_GATEWAY_PROTOCOL) ||
+        !ticket ||
+        consumed.has(ticket)
+      ) {
+        return false
+      }
+
+      consumed.add(ticket)
+
+      return true
+    },
+    handleProtocols: () => CANONICAL_GATEWAY_PROTOCOL
+  })
+
+  await new Promise<void>(resolve => server.once('listening', resolve))
+  const frames: any[] = []
+
+  const snapshot = {
+    session_id: scope.sessionId,
+    stored_session_id: scope.sessionId,
+    revision: 3,
+    execution_generation: 2,
+    replay_epoch: 'writer-epoch',
+    running: false,
+    messages: [],
+    prompts: [],
+    info: { profile_name: owner.profile }
+  }
+
+  server.on('connection', (socket: any) =>
+    socket.on('message', (bytes: Buffer) => {
+      const frame = JSON.parse(bytes.toString())
+      frames.push(frame)
+      let result: unknown = {}
+
+      if (frame.method === 'client.capabilities') {
+        result = { server_requests: [] }
+      }
+
+      if (['session.create', 'session.resume'].includes(frame.method)) {
+        result = snapshot
+      }
+
+      if (frame.method === 'prompt.submit') {
+        result = {
+          admission_id: 'accepted-admission',
+          ref: { session_id: scope.sessionId, profile_id: 'writer-id' },
+          sequence: 1,
+          status: 'queued',
+          outcome: null,
+          authority_epoch: 1,
+          execution_generation: null
+        }
+      }
+
+      socket.send(JSON.stringify({ jsonrpc: '2.0', id: frame.id, result }))
+    })
+  )
+  const client = new HermesGateway()
+  const base = `ws://127.0.0.1:${(server.address() as { port: number }).port}/api/ws`
+  const dial = (ticket = 'one-use-fixture') => `${base}?native_dial=fixture&ticket=${ticket}`
+
+  const complete = () => {
+    for (const socket of server.clients) {
+      socket.send(
+        JSON.stringify({
+          jsonrpc: '2.0',
+          method: 'event',
+          params: {
+            type: 'message.complete',
+            session_id: scope.sessionId,
+            replay_epoch: 'writer-epoch',
+            seq: 1,
+            execution_generation: 2,
+            payload: {
+              admission_id: 'accepted-admission',
+              status: 'complete',
+              outcome: 'completed',
+              text: 'canonical task completed',
+              persisted_turn: { user_row_id: 42, complete: true }
+            }
+          }
+        })
+      )
+    }
+  }
+
+  return {
+    client,
+    frames,
+    handshakes,
+    base,
+    dial,
+    complete,
+    async close() {
+      client.close()
+
+      for (const socket of server.clients) {
+        socket.terminate()
+      }
+
+      await new Promise<void>(resolve => server.close(() => resolve()))
+    }
+  }
+}
+
+test('private handshake rejects the legacy query-ticket dial and accepts fresh canonical subprotocols', async () => {
+  const h = await wire()
+
+  try {
+    await expect(h.client.connect(`${h.base}?ticket=legacy-fixture`)).rejects.toThrow(/Could not connect/)
+    await h.client.connect(h.dial())
+    expect(h.client.connectionState).toBe('open')
+    expect(h.handshakes[0]).toEqual({ url: '/api/ws?ticket=legacy-fixture', protocols: '' })
+    expect(h.handshakes[1].url).not.toContain('ticket=')
+    expect(h.handshakes[1].protocols.split(',').map(value => value.trim())).toEqual([
+      CANONICAL_GATEWAY_PROTOCOL,
+      'hermes-gateway-ticket.one-use-fixture'
+    ])
+    h.client.close()
+    await expect(h.client.connect(h.dial())).rejects.toThrow(/Could not connect/)
+    await h.client.connect(h.dial('second-fixture'))
+    expect(h.client.connectionState).toBe('open')
+  } finally {
+    await h.close()
+  }
+})
+
+test('voice create retains canonical GUI launch options and submits on the attached owner without a second resume', async () => {
+  const h = await wire()
+  const release = vi.fn()
+
+  try {
+    await h.client.connect(h.dial())
+    const captured = captureNativeGateway(h.client, owner.profile, release, () => true)
+
+    const created = await captured.request('session.create', {
+      profile: owner.profile,
+      request_id: 'create-intent',
+      source: 'desktop',
+      cwd: '/fixture/project',
+      cwd_explicit: true,
+      model: 'fixture-model',
+      provider: 'fixture-provider',
+      reasoning_effort: 'high',
+      fast: false,
+      title: 'Bot Chat',
+      hidden: true
+    })
+
+    expect(created).toMatchObject({ session_id: scope.sessionId })
+
+    const bridge = createGrokBridge({
+      owner,
+      request: captured.request,
+      rest: vi.fn(),
+      subscribe: captured.onEvent as never,
+      isCurrent: captured.isCurrent,
+      isBusy: async () => false
+    })
+
+    const receipt = await bridge.submit(scope, 'do work', { queued: true, context: 'voice context' })
+    expect(receipt).toMatchObject({ admission_id: 'accepted-admission', status: 'queued' })
+    expect(receipt).not.toHaveProperty('user_row_id')
+    const create = h.frames.find(frame => frame.method === 'session.create').params
+    expect(create).toMatchObject({
+      source: 'gui',
+      request_id: 'create-intent',
+      profile: 'writer',
+      cwd_explicit: true,
+      reasoning: 'high',
+      service_tier: 'normal',
+      model: 'fixture-model',
+      provider: 'fixture-provider',
+      title: 'Bot Chat',
+      hidden: true
+    })
+    expect(create).not.toHaveProperty('voiceOwner')
+    const submit = h.frames.find(frame => frame.method === 'prompt.submit').params
+    expect(submit).toMatchObject({
+      session_id: scope.sessionId,
+      profile: 'writer',
+      text: 'do work',
+      queued: true,
+      voice_context: 'voice context',
+      surface: 'voice-live',
+      submission_id: expect.any(String)
+    })
+    expect(submit).not.toHaveProperty('client_turn_id')
+    expect(h.frames.filter(frame => frame.method === 'session.resume')).toHaveLength(0)
+    const delivered = vi.fn()
+    const off = bridge.subscribe(scope, delivered)
+    h.complete()
+    await vi.waitFor(() => expect(delivered).toHaveBeenCalledOnce())
+    expect(delivered.mock.calls[0][0]).toMatchObject({
+      ...scope,
+      type: 'message.complete',
+      payload: { admission_id: 'accepted-admission', status: 'complete', text: 'canonical task completed' }
+    })
+    off()
+    captured.release()
+    expect(release).toHaveBeenCalledOnce()
+    expect(h.client.connectionState).toBe('open')
+  } finally {
+    await h.close()
+  }
+})
+
+test('an existing voice chat attaches on the captured socket before admission and cannot revive after redial', async () => {
+  const h = await wire()
+
+  try {
+    await h.client.connect(h.dial())
+    const captured = captureNativeGateway(h.client, owner.profile, vi.fn(), () => true)
+
+    const bridge = createGrokBridge({
+      owner,
+      request: captured.request,
+      rest: vi.fn(),
+      subscribe: captured.onEvent as never,
+      isCurrent: captured.isCurrent,
+      isBusy: async () => false
+    })
+
+    await bridge.submit(scope, 'work', { queued: true, context: '' })
+    expect(h.frames.filter(frame => frame.method !== 'client.capabilities').map(frame => frame.method)).toEqual([
+      'session.resume',
+      'prompt.submit'
+    ])
+    h.client.close()
+    await h.client.connect(h.dial('redial-fixture'))
+    await expect(bridge.submit(scope, 'must not replay', { queued: true, context: '' })).rejects.toThrow(/propriétaire/)
+    expect(h.frames.filter(frame => frame.method === 'prompt.submit')).toHaveLength(1)
+    captured.release()
+  } finally {
+    await h.close()
+  }
+})
+
+test.skipIf(!process.env.GROK_NATIVE_PLUGIN_ARTIFACT)(
+  'real API1 artifact connects the mounted broker shape and delivers canonical admission work, with startup mute and no hangup cancellation',
+  async () => {
+    const h = await wire()
+    const NativeSocket = globalThis.WebSocket
+    let provider: any
+    const sent: any[] = []
+    const track = { enabled: true, stop: vi.fn() }
+    let worklet: any
+    const node = () => ({ connect() {}, disconnect() {} })
+
+    class AudioContextFixture {
+      sampleRate = 24000
+      state = 'running'
+      currentTime = 0
+      destination = {}
+      audioWorklet = { addModule: async () => {} }
+      async resume() {}
+      async close() {
+        this.state = 'closed'
+      }
+      createMediaStreamSource() {
+        return node()
+      }
+      createGain() {
+        return { ...node(), gain: { value: 0 } }
