@@ -0,0 +1,86 @@
+import { type MutableRefObject, useCallback, useRef } from 'react'
+
+import { activeGatewayConnectionId, activeGatewayProfileKey } from '@/store/gateway'
+import { $newChatProfile, resolveNewChatOwnerRoute } from '@/store/profile'
+import type { SessionProfileRoute } from '@/store/session-request-router'
+
+import type { CreateBackendSessionForSend } from './use-session-actions/create-overrides'
+
+interface Owner {
+  connectionId: string | null
+  profile: string
+}
+
+export function resolveVoiceDraftOwner(): Owner {
+  const route = resolveNewChatOwnerRoute()
+
+  if (route) {
+    return route
+  }
+
+  const profile = $newChatProfile.get()
+
+  return { connectionId: profile ? null : activeGatewayConnectionId(), profile: profile || activeGatewayProfileKey() }
+}
+
+interface Dependencies {
+  runtime: MutableRefObject<string | null>
+  stored: MutableRefObject<string | null>
+  createSession: CreateBackendSessionForSend
+  resumeSession: (
+    storedId: string,
+    force: boolean,
+    owner?: SessionProfileRoute,
+    options?: { preserveActiveOwner?: boolean }
+  ) => Promise<unknown>
+}
+
+/** Use the native create/publication and stored-chat adoption doors; never fake a text submit. */
+export function useEnsureVoiceSession({ runtime, stored, createSession, resumeSession }: Dependencies) {
+  const pending = useRef<{ owner: Owner; promise: Promise<string | null> } | null>(null)
+
+  return useCallback(
+    async (owner: Owner): Promise<string | null> => {
+      if (pending.current) {
+        if (
+          pending.current.owner.connectionId !== owner.connectionId ||
+          pending.current.owner.profile !== owner.profile
+        ) {
+          throw new Error('Voice session owner changed')
+        }
+
+        return pending.current.promise
+      }
+
+      const selected = stored.current
+
+      if (!selected) {
+        const route = resolveVoiceDraftOwner()
+
+        if (route.connectionId !== owner.connectionId || route.profile !== owner.profile) {
+          throw new Error('Voice session owner changed')
+        }
+      }
+
+      const promise = selected
+        ? resumeSession(
+            selected,
+            true,
+            owner.connectionId ? { ...owner, connectionId: owner.connectionId } : undefined,
+            { preserveActiveOwner: true }
+          ).then(() => (stored.current === selected ? runtime.current : null))
+        : createSession(null, { voiceOwner: { ...owner } })
+
+      pending.current = { owner: { ...owner }, promise }
+
+      try {
+        return await promise
+      } finally {
+        if (pending.current?.promise === promise) {
+          pending.current = null
+        }
+      }
+    },
+    [runtime, stored, createSession, resumeSession]
+  )
+}
