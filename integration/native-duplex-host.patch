+import { act, cleanup, renderHook } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import type { LiveTranscriptFragment, VoiceLiveHandlers } from '@/lib/voice-live'
+import { notify } from '@/store/notifications'
+
+import { useVoiceLiveConversation } from './use-voice-live-conversation'
+
+const env = vi.hoisted(() => ({
+  sessions: [] as Array<{
+    handlers: VoiceLiveHandlers
+    close: ReturnType<typeof vi.fn>
+    speak: ReturnType<typeof vi.fn>
+    think: ReturnType<typeof vi.fn>
+    instruct: ReturnType<typeof vi.fn>
+  }>,
+  scope: { connectionId: 'offline-connection', profile: 'offline-profile' },
+  copy: { liveDelegationFailed: 'Could not send request to Hermes' }
+}))
+
+vi.mock('@/i18n', () => ({ useI18n: () => ({ t: { notifications: { voice: env.copy } } }) }))
+vi.mock('../scope', () => ({ useComposerScope: () => env.scope }))
+vi.mock('./use-mic-recorder', () => ({ micError: vi.fn() }))
+vi.mock('@/store/notifications', () => ({ notify: vi.fn(), notifyError: vi.fn() }))
+vi.mock('@/lib/voice-live', () => ({
+  VoiceLiveSession: class {
+    close = vi.fn()
+    speak = vi.fn()
+    think = vi.fn()
+    instruct = vi.fn()
+    setMuted = vi.fn()
+    start = vi.fn(async () => {})
+    constructor(
+      public handlers: VoiceLiveHandlers,
+      public owner: typeof env.scope
+    ) {
+      env.sessions.push(this)
+    }
+  }
+}))
+
+const REFUSAL =
+  'Hermes is already working on a request. This new request was not started. Please try again when it finishes.'
+
+async function mount(busy = false) {
+  let response: { id: string; pending: boolean; text: string } | null = null
+  let tool: string | null = null
+  const onSubmit = vi.fn()
+  const onInterrupt = vi.fn()
+  const onFatalError = vi.fn()
+  const onStopWord = vi.fn()
+
+  const consume = vi.fn(() => {
+    response = null
+  })
+
+  const hook = renderHook(
+    ({ busy: currentBusy }) =>
+      useVoiceLiveConversation({
+        busy: currentBusy,
+        enabled: true,
+        onSubmit,
+        onInterrupt,
+        onFatalError,
+        onStopWord,
+        consumePendingResponse: consume,
+        pendingResponse: () => response,
+        activeToolLabel: () => tool,
+        seedHistory: () => []
+      }),
+    { initialProps: { busy } }
+  )
+
+  await act(async () => {
+    await hook.result.current.start()
+  })
+  const session = env.sessions[0]!
+
+  return {
+    hook,
+    session,
+    onSubmit,
+    onInterrupt,
+    onFatalError,
+    onStopWord,
+    consume,
+    response: (value: typeof response) => {
+      response = value
+    },
+    tool: (value: typeof tool) => {
+      tool = value
+    },
+    delegate: (id: string, text = 'Run the original task') =>
+      act(() =>
+        session.handlers.onDelegation(id, [
+          { speaker: 'assistant', text: 'What should I do?' },
+          { speaker: 'user', text }
+        ] as LiveTranscriptFragment[])
+      ),
+    tick: () =>
+      act(() => {
+        vi.advanceTimersByTime(200)
+      })
+  }
+}
+
+beforeEach(() => {
+  vi.useFakeTimers()
+  vi.clearAllMocks()
+  env.sessions.length = 0
+  vi.stubGlobal(
+    'fetch',
+    vi.fn(() => {
+      throw new Error('Network forbidden in offline admission tests')
+    })
+  )
+})
+
+afterEach(() => {
+  cleanup()
+  vi.useRealTimers()
+  vi.unstubAllGlobals()
+})
+
+describe('OpenAI live delegation admission (real hook, offline session seam)', () => {
+  it('refuses a new delegation while nonvoice Hermes work is busy without consuming or cancelling it', async () => {
+    const h = await mount(true)
+    h.response({ id: 'nonvoice-reply', pending: false, text: 'Existing nonvoice result.' })
+    h.delegate('rejected')
+
+    expect(h.onSubmit).not.toHaveBeenCalled()
+    expect(h.onInterrupt).not.toHaveBeenCalled()
+    expect(h.consume).not.toHaveBeenCalled()
+    expect(h.session.close).not.toHaveBeenCalled()
+    expect(h.onFatalError).not.toHaveBeenCalled()
+    expect(h.onStopWord).not.toHaveBeenCalled()
+    expect(notify).toHaveBeenCalledWith(expect.objectContaining({ kind: 'warning', message: REFUSAL }))
+    expect(h.session.think).toHaveBeenCalledWith('rejected', expect.stringMatching(/not (accepted|started)/i))
+    expect(h.session.speak).not.toHaveBeenCalled()
+    expect(h.hook.result.current.status).toBe('listening')
+    h.tick()
+    expect(h.consume).not.toHaveBeenCalled()
+  })
+
+  it('preserves an accepted delegation during the pre-busy acknowledgement grace', async () => {
+    const h = await mount()
+    h.delegate('original')
+    expect(h.onSubmit).toHaveBeenCalledExactlyOnceWith(
+      'Run the original task',
+      'Voice assistant: What should I do?\nUser: Run the original task'
+    )
+    expect(h.consume).toHaveBeenCalledTimes(1)
+    h.delegate('rejected', 'Do something else')
+    expect(h.onSubmit).toHaveBeenCalledTimes(1)
+    expect(h.consume).toHaveBeenCalledTimes(1)
+    expect(h.onInterrupt).not.toHaveBeenCalled()
+    expect(h.session.close).not.toHaveBeenCalled()
+    expect(h.hook.result.current.status).toBe('thinking')
+    h.response({ id: 'original-reply', pending: false, text: 'Original result.' })
+    h.tick()
+    expect(h.session.speak).toHaveBeenCalledExactlyOnceWith('original', 'Original result.')
+    expect(h.hook.result.current.status).toBe('listening')
+  })
+
+  it('ignores duplicate accepted IDs both in flight and after settlement without conflicting commentary', async () => {
+    const h = await mount()
+    h.delegate('original')
+    h.delegate('original')
+    expect(h.onSubmit).toHaveBeenCalledTimes(1)
+    expect(h.consume).toHaveBeenCalledTimes(1)
+    expect(notify).not.toHaveBeenCalled()
+    expect(h.session.think).not.toHaveBeenCalled()
+    h.response({ id: 'original-reply', pending: false, text: 'Original result.' })
+    h.tick()
+    h.delegate('original')
+    expect(h.onSubmit).toHaveBeenCalledTimes(1)
+    expect(h.session.speak).toHaveBeenCalledExactlyOnceWith('original', 'Original result.')
+    expect(h.session.think).not.toHaveBeenCalled()
+    expect(notify).not.toHaveBeenCalled()
+  })
+
+  it('acknowledges a rejected ID only once and never later accepts a duplicate of it', async () => {
+    const h = await mount(true)
+    h.delegate('rejected')
+    h.delegate('rejected')
+    h.hook.rerender({ busy: false })
+    h.delegate('rejected')
+    expect(h.onSubmit).not.toHaveBeenCalled()
+    expect(h.consume).not.toHaveBeenCalled()
+    expect(h.session.think).toHaveBeenCalledTimes(1)
+    expect(notify).toHaveBeenCalledTimes(1)
+    expect(h.session.speak).not.toHaveBeenCalled()
+    expect(h.session.close).not.toHaveBeenCalled()
+  })
+
+  it('routes streamed original commentary without repeats after rejection, then admits a fresh ID after settlement', async () => {
+    const h = await mount()
+    h.delegate('original')
+    h.hook.rerender({ busy: true })
+    h.tool('Read files')
+    h.response({ id: 'original-reply', pending: true, text: 'First sentence. Still working' })
+    h.tick()
+    expect(h.session.speak).toHaveBeenCalledExactlyOnceWith('original', 'First sentence.')
+    expect(h.session.think).toHaveBeenCalledWith('original', 'Hermes is working: Read files. Not done yet.')
+    h.delegate('rejected', 'Do something else')
+    h.tick()
+    expect(h.onSubmit).toHaveBeenCalledTimes(1)
+    expect(h.consume).toHaveBeenCalledTimes(1)
+    expect(h.session.speak).toHaveBeenCalledTimes(1)
+    expect(h.session.think.mock.calls.filter(([id]) => id === 'original')).toHaveLength(1)
+    expect(h.onInterrupt).not.toHaveBeenCalled()
+    expect(h.session.close).not.toHaveBeenCalled()
+    h.response({ id: 'original-reply', pending: false, text: 'First sentence. Original tail.' })
+    h.tool(null)
+    h.hook.rerender({ busy: false })
+    expect(h.session.speak.mock.calls).toEqual([
+      ['original', 'First sentence.'],
+      ['original', ' Original tail.']
+    ])
+    expect(h.consume).toHaveBeenCalledTimes(2)
+    expect(h.hook.result.current.status).toBe('listening')
+    h.delegate('fresh', 'A fresh task')
+    expect(h.onSubmit).toHaveBeenCalledTimes(2)
+    expect(h.onSubmit).toHaveBeenLastCalledWith(
+      'A fresh task',
+      'Voice assistant: What should I do?\nUser: A fresh task'
+    )
+    h.response({ id: 'fresh-reply', pending: false, text: 'Fresh result.' })
+    h.tick()
+    expect(h.session.speak).toHaveBeenLastCalledWith('fresh', 'Fresh result.')
+    expect(h.hook.result.current.status).toBe('listening')
+  })
+
+  it('does not end the accepted session even when a rejected delegation contains a stop command', async () => {
+    const h = await mount()
+    h.delegate('original')
+    h.delegate('rejected-stop', 'stop')
+    expect(h.session.close).not.toHaveBeenCalled()
+    expect(h.onStopWord).not.toHaveBeenCalled()
+    expect(h.onInterrupt).not.toHaveBeenCalled()
+    expect(h.onSubmit).toHaveBeenCalledTimes(1)
+    expect(h.consume).toHaveBeenCalledTimes(1)
+    expect(h.hook.result.current.status).toBe('thinking')
+  })
+})
