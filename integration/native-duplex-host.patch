diff --git a/apps/desktop/src/lib/voice-grok-bridge.test.ts b/apps/desktop/src/lib/voice-grok-bridge.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a209ae30c2d9b2b01ef5f305b9b73e07df8e4fdc
--- /dev/null
+++ b/apps/desktop/src/lib/voice-grok-bridge.test.ts
@@ -0,0 +1,159 @@
+import { describe, expect, it, vi } from 'vitest'
+
+import type { GrokCompletion } from './voice-grok'
+import { createGrokBridge } from './voice-grok-bridge'
+
+describe('captured native Grok bridge', () => {
+  it('preserves captured owner for mint, queued submit and completion routing', async () => {
+    const scope = { sessionId: 'session', owner: { connectionId: 'remote', profile: 'work' } }
+    const request = vi.fn(async () => ({ status: 'streaming', user_row_id: 8 }))
+
+    const rest = vi.fn(async ({ method }: { method: string }) =>
+      method === 'GET'
+        ? { ok: true, available: true, model: 'grok-voice-latest', voice: 'eve' }
+        : {
+            ok: true,
+            url: 'wss://api.x.ai/v1/realtime?model=grok-voice-latest',
+            protocol_prefix: 'xai-client-secret.',
+            client_secret: { value: 'fixture', expires_at: Date.now() / 1000 + 60 },
+            session: {
+              voice: 'eve',
+              instructions: 'fixture',
+              tools: [],
+              audio: {
+                input: { format: { type: 'audio/pcm', rate: 24000 } },
+                output: { format: { type: 'audio/pcm', rate: 24000 } }
+              }
+            }
+          }
+    )
+
+    let receive!: (event: {
+      type: string
+      session_id?: string
+      profile?: string
+      connectionId?: string
+      replayed?: boolean
+      payload?: GrokCompletion['payload']
+    }) => void
+
+    const dispose = vi.fn()
+
+    const bridge = createGrokBridge({
+      owner: scope.owner,
+      request,
+      rest,
+      isCurrent: () => true,
+      isBusy: async () => false,
+      subscribe: cb => {
+        receive = cb
+
+        return dispose
+      }
+    })
+
+    const minted = await bridge.mint(scope, { voice: 'Ara' })
+    expect(minted).toMatchObject({
+      endpoint: 'wss://api.x.ai/v1/realtime',
+      subprotocol: 'xai-client-secret.',
+      session_update: { type: 'session.update', session: { voice: 'eve' } }
+    })
+    await bridge.submit(scope, 'work', { queued: true, context: 'user: context' })
+    expect(rest).toHaveBeenCalledWith({
+      path: '/api/plugins/grok-voice-oauth/session',
+      method: 'POST',
+      body: { voice: 'Ara' },
+      connectionId: 'remote',
+      profile: 'work'
+    })
+    expect(request).toHaveBeenCalledWith('prompt.submit', {
+      session_id: 'session',
+      text: 'work',
+      surface: 'voice-live',
+      voice_context: 'user: context',
+      queued: true,
+      profile: 'work'
+    })
+    const listener = vi.fn()
+    const unsubscribe = bridge.subscribe(scope, listener)
+    receive({ type: 'message.complete', session_id: 'other', profile: 'work' })
+    receive({ type: 'message.complete', session_id: 'session', profile: 'other' })
+    receive({ type: 'message.complete', session_id: 'session', profile: 'work', connectionId: 'wrong' })
+    receive({ type: 'message.complete', session_id: 'session', profile: 'work', replayed: true })
+    receive({
+      type: 'message.complete',
+      session_id: 'session',
+      profile: 'work',
+      payload: { text: 'Done', persisted_turn: { user_row_id: 8, complete: true } }
+    })
+    expect(listener).toHaveBeenCalledOnce()
+    expect(listener.mock.calls[0][0]).toMatchObject({ ...scope, type: 'message.complete' })
+    unsubscribe()
+    expect(dispose).toHaveBeenCalledOnce()
+  })
+  it.each(['status', 'mint'])('fences owner invalidation during the pending %s response', async phase => {
+    const scope = { sessionId: 'session', owner: { connectionId: 'remote', profile: 'work' } }
+    let current = true
+    let release!: (value: unknown) => void
+    const ready = { ok: true, available: true, model: 'grok-voice-latest', voice: 'eve' }
+
+    const response = {
+      ok: true,
+      url: 'wss://api.x.ai/v1/realtime?model=grok-voice-latest',
+      protocol_prefix: 'xai-client-secret.',
+      client_secret: { value: 'fixture', expires_at: Date.now() / 1000 + 60 },
+      session: {
+        voice: 'eve',
+        instructions: 'fixture',
+        tools: [],
+        audio: {
+          input: { format: { type: 'audio/pcm', rate: 24000 } },
+          output: { format: { type: 'audio/pcm', rate: 24000 } }
+        }
+      }
+    }
+
+    const rest = vi.fn(({ method }: { method: string }) =>
+      method === 'GET' && phase === 'mint'
+        ? Promise.resolve(ready)
+        : new Promise(resolve => {
+            release = resolve
+          })
+    )
+
+    const bridge = createGrokBridge({
+      owner: scope.owner,
+      request: vi.fn(),
+      rest,
+      isCurrent: () => current,
+      isBusy: async () => false,
+      subscribe: () => () => {}
+    })
+
+    const pending = bridge.mint(scope)
+    await vi.waitFor(() => expect(release).toBeTypeOf('function'))
+    current = false
+    release(phase === 'status' ? ready : response)
+    await expect(pending).rejects.toThrow()
+    expect(rest).toHaveBeenCalledTimes(phase === 'status' ? 1 : 2)
+  })
+
+  it('refuses mismatched owners instead of rerouting to ambient connection', async () => {
+    const request = vi.fn()
+    const rest = vi.fn()
+
+    const bridge = createGrokBridge({
+      owner: { connectionId: 'local', profile: 'default' },
+      request,
+      rest,
+      isCurrent: () => true,
+      isBusy: async () => false,
+      subscribe: () => () => {}
+    })
+
+    const scope = { sessionId: 'session', owner: { connectionId: 'other', profile: 'default' } }
+    await expect(bridge.submit(scope, 'work', { queued: true, context: '' })).rejects.toThrow(/propriétaire/)
+    expect(request).not.toHaveBeenCalled()
+    expect(rest).not.toHaveBeenCalled()
+  })
+})
