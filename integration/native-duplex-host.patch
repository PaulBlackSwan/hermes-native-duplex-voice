--- /dev/null
+++ b/apps/desktop/src/lib/voice-grok-bridge.ts
@@ -0,0 +1,95 @@
+import type { GrokBridge, GrokCompletion, GrokOwner, GrokScope } from './voice-grok'
+import { createGrokBroker } from './voice-grok-broker'
+
+export interface GrokGatewayEvent {
+  type: string
+  session_id?: string
+  profile?: string
+  connectionId?: string
+  replayed?: boolean
+  payload?: GrokCompletion['payload']
+}
+export interface GrokBridgeTransport {
+  /** The gateway and REST caller must be captured synchronously for this owner. */
+  owner: GrokOwner
+  request(method: string, params: Record<string, unknown>): Promise<unknown>
+  rest(options: {
+    path: string
+    method: string
+    body?: unknown
+    connectionId: string | null
+    profile: string | null
+  }): Promise<unknown>
+  subscribe(listener: (event: GrokGatewayEvent) => void): () => void
+  isCurrent(scope: GrokScope): boolean
+  isBusy(scope: GrokScope): Promise<boolean>
+}
+
+/** Small native adapter, not a plugin registry. No ambient scope reads. */
+export function createGrokBridge(transport: GrokBridgeTransport): GrokBridge {
+  const owner = { ...transport.owner }
+
+  const owns = (scope: GrokScope) =>
+    scope.owner.connectionId === owner.connectionId && scope.owner.profile === owner.profile
+
+  function assertOwner(scope: GrokScope): void {
+    if (!owns(scope) || !transport.isCurrent(scope)) {
+      throw new Error('Le propriétaire de l’appel vocal a changé.')
+    }
+  }
+
+  return {
+    isCurrent: scope => owns(scope) && transport.isCurrent(scope),
+    async isBusy(scope) {
+      assertOwner(scope)
+
+      return transport.isBusy(scope)
+    },
+    async mint(scope, config = {}) {
+      assertOwner(scope)
+
+      const minted = await createGrokBroker(owner, async (_owner, request) => {
+        assertOwner(scope)
+
+        return transport.rest({ ...request, method: request.method ?? 'GET', ...owner })
+      }).mint(config)
+
+      assertOwner(scope)
+
+      return minted
+    },
+    async submit(scope, text, options) {
+      assertOwner(scope)
+      const context = options.context.slice(-6_000)
+
+      return (await transport.request('prompt.submit', {
+        session_id: scope.sessionId,
+        text,
+        surface: 'voice-live',
+        voice_context: context,
+        queued: true,
+        profile: owner.profile
+      })) as { status?: string; user_row_id?: number; admission_id?: string }
+    },
+    subscribe(scope, listener) {
+      assertOwner(scope)
+
+      return transport.subscribe(event => {
+        // Missing route metadata is not evidence of ownership. The captured socket
+        // establishes connection identity; the native event must establish profile/session.
+        if (
+          event.replayed === true ||
+          (event.connectionId !== undefined && event.connectionId !== owner.connectionId) ||
+          event.type !== 'message.complete' ||
+          event.session_id !== scope.sessionId ||
+          event.profile !== owner.profile ||
+          !owns(scope)
+        ) {
+          return
+        }
+
+        listener({ type: event.type, payload: event.payload, sessionId: scope.sessionId, owner: { ...owner } })
+      })
+    }
+  }
+}
