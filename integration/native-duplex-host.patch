+
+  if (call.options.target === 'main') {
+    const status = next.status === 'connecting' ? 'thinking' : next.status === 'error' ? 'idle' : next.status
+    call.indicatorOwned = syncWakeIndicatorWithVoice(next.active, status) || call.indicatorOwned
+  }
+}
+
+function finish(call: Call, rawReason: string): void {
+  if (current !== call) {
+    return
+  }
+
+  current = null
+  const reasons = ['hangup', 'owner_changed', 'plugin_unloaded', 'end_call', 'error', 'transport_closed', 'pagehide']
+  const closeReason = reasons.includes(rawReason) ? rawReason : 'error'
+  call.cleanup.forEach(release => release())
+  call.gateway?.release()
+
+  if (call.indicatorOwned) {
+    clearWakeIndicator()
+  }
+
+  if (call.wakeBarrier) {
+    void call.wakeBarrier
+      .then(() => {
+        if (!current) {
+          return resumeWakeAfterVoice()
+        }
+      })
+      .catch(() => undefined)
+  }
+
+  $nativeLiveCall.set({
+    ...$nativeLiveCall.get(),
+    active: false,
+    status: 'idle',
+    muted: false,
+    level: 0,
+    closeReason,
+    closeSequence: $nativeLiveCall.get().closeSequence + 1
+  })
+  // Fixed category only: never the raw provider reason, owner, transcript or credential.
+  console.info('[native-live-call]', closeReason)
+}
+
+export function endNativeLiveCall(reason = 'hangup'): void {
+  const call = current
+
+  if (!call) {
+    return
+  }
+
+  try {
+    call.session?.end(reason)
+  } finally {
+    finish(call, reason)
+  }
+}
+
+function check(call: Call): void {
+  if (current !== call) {
+    return
+  }
+
+  if (!valid(call)) {
+    endNativeLiveCall('owner_changed')
+  } else {
+    call.session?.checkOwner()
+  }
+}
+
+function bridgeFor(call: Call) {
+  const { owner } = call.scope
+
+  return createGrokBridge({
+    owner,
+    isCurrent: scope => valid(call) && scope.sessionId === call.scope.sessionId && sameOwner(scope.owner, owner),
+    request: async (method, params) => {
+      const releaseTurn = await retainGatewayForSessionTurn(owner.connectionId, owner.profile!, call.scope.sessionId)
+
+      try {
+        if (!valid(call)) {
+          throw new Error('Voice owner changed')
+        }
+
+        return await call.gateway!.request(method, params)
+      } catch (error) {
+        releaseTurn()
+        throw error
+      }
+    },
+    rest: ({ path, method, body }) => hermesApiAs(call.brokerOwner, { path, method, body }),
+    subscribe: listener =>
+      call.gateway!.onEvent(event => {
+        const routed = event as GrokGatewayEvent
+
+        if (
+          event.type === 'message.complete' &&
+          valid(call) &&
+          (routed.profile === undefined || routed.profile === owner.profile) &&
+          (routed.connectionId === undefined || routed.connectionId === owner.connectionId)
+        ) {
+          listener({ ...event, profile: owner.profile, connectionId: owner.connectionId } as GrokGatewayEvent)
+        }
+      }),
+    isBusy: async () =>
+      call.options.target === 'main' ? $busy.get() : $sessionStates.get()[call.scope.sessionId]?.busy !== false
+  })
+}
+
+function watch(call: Call): void {
+  const verify = () => check(call)
+  call.cleanup.push(
+    call.gateway!.onState(verify),
+    $gateway.listen(verify),
+    $apiRequestScope.listen(verify),
+    $activeSessionId.listen(verify),
+    $nativeLiveProviders.listen(() => {
+      if (current === call && $nativeLiveProviders.get()['xai-oauth'] !== call.provider) {
+        endNativeLiveCall('plugin_unloaded')
+      }
+    })
+  )
+  const hide = () => endNativeLiveCall('pagehide')
+  window.addEventListener('pagehide', hide)
+  call.cleanup.push(() => window.removeEventListener('pagehide', hide))
+}
+
+/** One window-owned call. React views only subscribe; unmount is not permission to hang up. */
+export async function startNativeLiveCall(options: StartOptions): Promise<void> {
+  if (current) {
+    return
+  }
+
+  const provider = $nativeLiveProviders.get()['xai-oauth']
+
+  if (!provider) {
+    notify({ id: 'voice-grok-error', kind: 'error', message: 'Le plugin Grok Voice natif est indisponible.' })
+
+    return
+  }
+
+  // Resolve the triggering session before the first await. A named Bot Chat can
+  // be displayed from a different launch profile; capture its route once.
+  const triggerOwner = options.sessionId ? knownOwnerForSession(options.sessionId) : undefined
+
+  const owner = triggerOwner
+    ? typeof triggerOwner === 'string'
+      ? { ...options.owner, profile: triggerOwner }
+      : { connectionId: triggerOwner.connectionId, profile: triggerOwner.targetProfile ?? triggerOwner.profile }
+    : { ...options.owner }
+
+  const call: Call = {
+    options,
+    provider,
+    scope: { owner, sessionId: options.sessionId || '' },
+    // Session routing must not move OAuth lookup into another profile.
+    brokerOwner: { ...options.owner },
+    cleanup: []
+  }
+
+  current = call
+  publish(call, {
+    active: true,
+    scope: call.scope,
+    target: options.target,
+    status: 'connecting',
+    muted: false,
+    level: 0,
+    closeReason: null
+  })
+
+  try {
+    const gateway = await captureGatewayForAgent(owner.connectionId, owner.profile!)
+
+    if (current !== call) {
+      gateway.release()
+
+      return
+    }
+
+    call.gateway = gateway
+    watch(call)
+
+    if (!call.scope.sessionId) {
+      const sessionId = await options.onEnsureSession?.({ ...owner, profile: owner.profile! })
+
+      if (current !== call) {
+        return
+      }
+
+      if (!sessionId) {
+        throw new Error('Native session unavailable')
+      }
+
+      call.scope = { ...call.scope, sessionId }
+      publish(call, { scope: call.scope })
+    }
+
+    await Promise.resolve()
+    await options.beforeMicOpen?.()
+
+    if (!valid(call)) {
+      check(call)
+
+      return
+    }
+
+    // The call, not the composer view, owns wake suspension until final teardown.
+    call.wakeBarrier = Promise.resolve($gateway.get()?.request('wake.pause', {})).catch(() => undefined)
+    await call.wakeBarrier
+
+    if (!valid(call)) {
+      check(call)
+
+      return
+    }
+
+    call.session = createNativeLiveSession('xai-oauth', bridgeFor(call), {
+      onStatus: status => publish(call, { status }),
+      onLevel: level => publish(call, { level: Math.max(0, Math.min(1, level)) }),
+      onError: message => {
+        if (current === call) {
+          notify({ id: 'voice-grok-error', kind: 'error', message })
+        }
+      },
+      onNotice: message => {
+        if (current === call) {
+          notify({ id: 'voice-grok-notice', kind: 'info', message })
+        }
+      },
+      onClosed: reason => finish(call, reason)
+    })
+    // Mute may have been requested while awaiting gateway/session/wake readiness.
+    call.session.setMuted($nativeLiveCall.get().muted)
+    await call.session.start(call.scope)
+  } catch {
+    if (current === call) {
+      notify({
+        id: 'voice-grok-error',
+        kind: 'error',
+        message: 'Impossible de démarrer Grok Voice. Vérifiez la connexion et le plugin.'
+      })
+      endNativeLiveCall('error')
+    }
+  }
+}
+
+export function toggleNativeLiveMute(): void {
+  if (!current) {
+    return
+  }
+
+  const muted = !$nativeLiveCall.get().muted
+  current.session?.setMuted(muted)
+  publish(current, { muted })
+}
+
+export function interruptNativeLiveTurn(): void {
+  current?.session?.stopTurn()
+}
