@@ -0,0 +1,113 @@
+import { hermesApiAs, type ResolvedOwner } from '@/api/client'
+import type { HermesApiRequest } from '@/global'
+
+import type { GrokMint } from './voice-grok'
+
+interface BrokerStatus {
+  available: boolean
+  reason: string | null
+}
+
+type BrokerApi = (owner: ResolvedOwner, request: HermesApiRequest) => Promise<unknown>
+const UNAVAILABLE = 'Grok Voice indisponible sur ce profil Hermes.'
+const INVALID = 'Réponse de session Grok Voice invalide.'
+
+function isPcmFormat(raw: unknown): boolean {
+  const format = raw as { type?: unknown; rate?: unknown } | null
+
+  return format?.type === 'audio/pcm' && format.rate === 24_000
+}
+
+/** Fixed core-only broker; no REST capability is handed to the provider. */
+export function createGrokBroker(owner: ResolvedOwner, api: BrokerApi = hermesApiAs) {
+  const captured = { ...owner }
+  const request = (options: HermesApiRequest) => api(captured, options)
+
+  async function status(): Promise<BrokerStatus> {
+    if (!captured.profile || captured.profile === 'current' || captured.profile !== captured.profile.trim()) {
+      return { available: false, reason: UNAVAILABLE }
+    }
+
+    try {
+      const raw = (await request({ path: '/api/plugins/grok-voice-oauth/status', method: 'GET' })) as Record<
+        string,
+        unknown
+      > | null
+
+      const available =
+        raw?.ok === true &&
+        raw.available === true &&
+        raw.model === 'grok-voice-latest' &&
+        typeof raw.voice === 'string' &&
+        raw.voice.trim().length > 0
+
+      return { available, reason: available ? null : UNAVAILABLE }
+    } catch {
+      return { available: false, reason: UNAVAILABLE }
+    }
+  }
+
+  async function mint(config: Record<string, unknown> = {}): Promise<GrokMint> {
+    if (!(await status()).available) {
+      throw new Error(UNAVAILABLE)
+    }
+
+    let raw: Record<string, unknown>
+
+    try {
+      raw = (await request({ path: '/api/plugins/grok-voice-oauth/session', method: 'POST', body: config })) as Record<
+        string,
+        unknown
+      >
+    } catch {
+      throw new Error(UNAVAILABLE)
+    }
+
+    const secret = raw?.client_secret as GrokMint['client_secret'] | undefined
+    const session = raw?.session as Record<string, unknown> | undefined
+    const audio = session?.audio as { input?: { format?: unknown }; output?: { format?: unknown } } | undefined
+    const now = Date.now() / 1000
+
+    if (
+      raw?.ok !== true ||
+      raw.url !== 'wss://api.x.ai/v1/realtime?model=grok-voice-latest' ||
+      raw.protocol_prefix !== 'xai-client-secret.' ||
+      typeof secret?.value !== 'string' ||
+      !/^[A-Za-z0-9._~-]{1,4096}$/.test(secret.value) ||
+      typeof secret.expires_at !== 'number' ||
+      !Number.isFinite(secret.expires_at) ||
+      secret.expires_at <= now ||
+      secret.expires_at > now + 330 ||
+      !isPcmFormat(audio?.input?.format) ||
+      !isPcmFormat(audio?.output?.format) ||
+      !session ||
+      Array.isArray(session) ||
+      typeof session !== 'object' ||
+      typeof session.voice !== 'string' ||
+      !session.voice ||
+      typeof session.instructions !== 'string' ||
+      !Array.isArray(session.tools) ||
+      session.tools.some(
+        tool =>
+          !tool ||
+          typeof tool !== 'object' ||
+          Array.isArray(tool) ||
+          tool.type !== 'function' ||
+          typeof tool.name !== 'string' ||
+          !tool.parameters ||
+          typeof tool.parameters !== 'object'
+      )
+    ) {
+      throw new Error(INVALID)
+    }
+
+    return {
+      endpoint: 'wss://api.x.ai/v1/realtime',
+      subprotocol: 'xai-client-secret.',
+      client_secret: { value: secret.value, expires_at: secret.expires_at },
+      session_update: { type: 'session.update', session: { ...session, model: 'grok-voice-latest' } }
+    }
+  }
+
+  return { status, mint }
+}
