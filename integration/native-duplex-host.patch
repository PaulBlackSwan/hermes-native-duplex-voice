+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import { type GrokBridge, type GrokCompletion, GrokLiveSession, type GrokSocket } from './voice-grok'
+import { PcmPlaybackOverflow } from './voice-pcm'
+
+const owner = { connectionId: 'local', profile: 'default' }
+const options = { sessionId: 'session', owner }
+
+const minted = () => ({
+  endpoint: 'wss://api.x.ai/v1/realtime',
+  subprotocol: 'xai-client-secret.',
+  client_secret: { value: 'ephemeral-test', expires_at: Date.now() / 1000 + 60 },
+  session_update: { type: 'session.update', session: {} }
+})
+
+const tick = async () => {
+  for (let i = 0; i < 8; i++) {
+    await Promise.resolve()
+  }
+}
+
+function setup() {
+  let listener: (event: GrokCompletion) => void = () => {}
+
+  let frame: (value: Float32Array) => void = () => {}
+  const sent: Record<string, any>[] = []
+
+  const socket = {
+    readyState: 1,
+    bufferedAmount: 0,
+    onopen: null,
+    onmessage: null,
+    onclose: null,
+    onerror: null,
+    send: (s: string) => sent.push(JSON.parse(s)),
+    close: vi.fn()
+  } as unknown as GrokSocket
+
+  const audio = {
+    player: { resume: vi.fn(async () => {}), play: vi.fn(), flush: vi.fn(), close: vi.fn(), hasPending: () => false },
+    startMic: vi.fn(async (cb: typeof frame) => {
+      frame = cb
+
+      return vi.fn()
+    }),
+    setMuted: vi.fn(),
+    close: vi.fn()
+  }
+
+  const bridge: GrokBridge = {
+    mint: vi.fn(async () => minted()),
+    isCurrent: vi.fn(() => true),
+    isBusy: vi.fn(async () => false),
+    submit: vi.fn(async () => ({ status: 'streaming', user_row_id: 42 })),
+    subscribe: vi.fn((_scope, cb) => {
+      listener = cb
+
+      return vi.fn()
+    })
+  }
+
+  const handlers = {
+    onStatus: vi.fn(),
+    onError: vi.fn(),
+    onClosed: vi.fn(),
+    onNotice: vi.fn(),
+    onTranscript: vi.fn(),
+    onLevel: vi.fn()
+  }
+
+  const session = new GrokLiveSession(bridge, handlers, { audio: () => audio, socket: () => socket })
+
+  const event = async (data: object) => {
+    socket.onmessage?.({ data: JSON.stringify(data) } as MessageEvent)
+    await tick()
+  }
+
+  const ready = async () => {
+    await session.start(options)
+    socket.onopen?.({} as Event)
+    await event({ type: 'session.updated' })
+  }
+
+  const complete = (id = 42, text = 'Done', route = options) =>
+    listener({
+      ...route,
+      type: 'message.complete',
+      payload: { text, persisted_turn: { user_row_id: id, complete: true } }
+    })
+
+  const tool = () =>
+    event({
+      type: 'response.function_call_arguments.done',
+      name: 'hermes_task',
+      call_id: 'call-1',
+      arguments: '{"request":"Do work"}'
+    })
+
+  return {
+    session,
+    bridge,
+    handlers,
+    audio,
+    socket,
+    sent,
+    event,
+    ready,
+    tool,
+    complete,
+    deliver: (event: GrokCompletion) => listener(event),
+    frame: (f: Float32Array) => frame(f)
+  }
+}
+
+afterEach(() => vi.useRealTimers())
+describe('native Grok receipts and interruptions', () => {
+  it('recovers only a cancel-not-active error correlated to our own cancel event', async () => {
+    const log = vi.spyOn(console, 'error').mockImplementation(() => {})
+    const h = setup()
