+    try {
+      await h.ready()
+      await h.tool()
+      h.session.stopTurn()
+      const cancel = h.sent.find(e => e.type === 'response.cancel')!
+      await h.event({
+        type: 'error',
+        error: {
+          type: 'invalid_request_error',
+          code: 'response_cancel_not_active',
+          event_id: cancel.event_id,
+          message: 'private-token transcript'
+        }
+      })
+      expect(h.socket.close).not.toHaveBeenCalled()
+      expect(h.handlers.onError).not.toHaveBeenCalled()
+      expect(h.handlers.onNotice).toHaveBeenCalled()
+      expect(JSON.stringify(log.mock.calls)).not.toContain('private-token')
+      h.complete(42, 'Work survived cancel race')
+      await h.event({ type: 'response.done' })
+      expect(JSON.stringify(h.sent)).toContain('Work survived cancel race')
+      expect(h.bridge.submit).toHaveBeenCalledOnce()
+    } finally {
+      h.session.end()
+      log.mockRestore()
+    }
+  })
