diff --git a/apps/desktop/src/app/settings/voice-live-provider.test.ts b/apps/desktop/src/app/settings/voice-live-provider.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4287dda20937895862d75042784c5f885c329b8b
--- /dev/null
+++ b/apps/desktop/src/app/settings/voice-live-provider.test.ts
@@ -0,0 +1,25 @@
+import { describe, expect, it } from 'vitest'
+
+import type { HermesConfigRecord } from '@/types/hermes'
+
+import { configSubpageForField } from './config-subpages'
+import { enumOptionsFor, voiceFieldVisible } from './helpers'
+
+const config = { voice: { voice_chat_mode: 'gpt-live', live_provider: 'xai-oauth' } } as unknown as HermesConfigRecord
+
+describe('native Live Voice settings', () => {
+  it('shows only the selected live provider fields without hiding the provider selector', () => {
+    expect(voiceFieldVisible('voice.grok_live.voice', config)).toBe(true)
+    expect(voiceFieldVisible('voice.gpt_live.voice', config)).toBe(false)
+    expect(voiceFieldVisible('voice.live_provider', config)).toBe(true)
+    const legacy = { voice: { voice_chat_mode: 'gpt-live' } } as unknown as HermesConfigRecord
+    expect(voiceFieldVisible('voice.gpt_live.voice', legacy)).toBe(true)
+    expect(voiceFieldVisible('voice.grok_live.voice', legacy)).toBe(false)
+  })
+  it('offers Grok OAuth beside OpenAI on the existing conversation settings page', () => {
+    expect(enumOptionsFor('voice.live_provider', 'openai', config)).toEqual(['openai', 'xai-oauth'])
+    expect(configSubpageForField('voice', 'voice.live_provider')).toBe('conversation')
+    expect(configSubpageForField('voice', 'voice.grok_live.voice')).toBe('conversation')
+    expect(configSubpageForField('voice', 'voice.gpt_live.voice')).toBe('conversation')
+  })
+})
