+
+import { createGrokBroker } from './voice-grok-broker'
+
+const owner = { connectionId: 'remote-b', profile: 'bot-b' }
+const ready = { ok: true, available: true, model: 'grok-voice-latest', voice: 'eve', message: null }
+
+const mint = () => ({
+  ok: true,
+  url: 'wss://api.x.ai/v1/realtime?model=grok-voice-latest',
+  protocol_prefix: 'xai-client-secret.',
+  client_secret: { value: 'fixture-ephemeral', expires_at: Math.floor(Date.now() / 1000) + 60 },
+  session: {
+    voice: 'eve',
+    instructions: 'fixture',
+    tools: [],
+    turn_detection: { type: 'server_vad' },
+    audio: {
