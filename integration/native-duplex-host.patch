+      output: { format: { type: 'audio/pcm', rate: 24000 } }
+    }
+  }
+})
+
+describe('fixed native Grok broker', () => {
+  it('normalizes the mounted plugin response into the real engine contract, scoped to the captured owner', async () => {
+    const api = vi.fn().mockResolvedValueOnce(ready).mockResolvedValueOnce(mint())
+    const broker = createGrokBroker(owner, api)
+    owner.profile = 'bot-b'
+    expect(await broker.mint()).toEqual({
+      endpoint: 'wss://api.x.ai/v1/realtime',
+      subprotocol: 'xai-client-secret.',
+      client_secret: mint().client_secret,
+      session_update: { type: 'session.update', session: { ...mint().session, model: 'grok-voice-latest' } }
+    })
+    expect(api.mock.calls).toEqual([
+      [
+        { connectionId: 'remote-b', profile: 'bot-b' },
+        { path: '/api/plugins/grok-voice-oauth/status', method: 'GET' }
+      ],
+      [
+        { connectionId: 'remote-b', profile: 'bot-b' },
+        { path: '/api/plugins/grok-voice-oauth/session', method: 'POST', body: {} }
+      ]
+    ])
+  })
+
+  it('rejects a session configured for a different audio format', async () => {
+    const api = vi
+      .fn()
+      .mockResolvedValueOnce(ready)
+      .mockResolvedValueOnce({
+        ...mint(),
+        session: {
+          ...mint().session,
+          audio: {
+            input: { format: { type: 'audio/pcm', rate: 16000 } },
+            output: { format: { type: 'audio/pcm', rate: 24000 } }
+          }
+        }
+      })
+
+    await expect(createGrokBroker(owner, api).mint()).rejects.toThrow('Réponse de session Grok Voice invalide.')
+  })
+
+  it('rejects malformed tool entries rather than sending an untyped session update', async () => {
+    const api = vi
+      .fn()
+      .mockResolvedValueOnce(ready)
+      .mockResolvedValueOnce({ ...mint(), session: { ...mint().session, tools: [null] } })
+
+    await expect(createGrokBroker(owner, api).mint()).rejects.toThrow('Réponse de session Grok Voice invalide.')
+  })
+
+  it.each([
+    null,
+    { ok: false, available: true },
+    { ...ready, available: false },
+    { ...ready, available: 'true' },
+    { ...ready, model: 'wrong' },
+    { ...ready, voice: null },
+    { ...ready, voice: '' }
+  ])('does not mint when broker status is absent, disabled or malformed (%j)', async status => {
+    const api = vi.fn().mockResolvedValue(status)
+    await expect(createGrokBroker(owner, api).mint()).rejects.toThrow('Grok Voice indisponible sur ce profil Hermes.')
+    expect(api).toHaveBeenCalledTimes(1)
+  })
+
+  it.each([null, '', 'current', ' bot '])(
+    'does not contact the broker without an explicit valid profile (%j)',
+    async profile => {
+      const api = vi.fn()
+      await expect(createGrokBroker({ connectionId: 'remote', profile }, api).mint()).rejects.toThrow()
+      expect(api).not.toHaveBeenCalled()
+    }
+  )
+
+  it.each([
+    { url: 'wss://evil.invalid/v1/realtime?model=grok-voice-latest' },
+    { url: 'wss://api.x.ai/v1/realtime?model=other' },
+    { protocol_prefix: 'Bearer ' },
+    { client_secret: { value: 'token with whitespace', expires_at: 1e20 } },
+    { client_secret: { value: 'fixture', expires_at: Date.now() / 1000 - 1 } },
+    { client_secret: { value: 'fixture', expires_at: Date.now() / 1000 + 331 } },
+    { client_secret: { value: 'fixture', expires_at: '9999999999' } },
+    { client_secret: { value: 'fixture', expires_at: Number.NaN } },
+    { client_secret: null },
+    { session: [] },
+    { session: null },
+    { ok: false }
+  ])('rejects unsafe session credentials or response types (%j)', async invalid => {
+    const api = vi
+      .fn()
+      .mockResolvedValueOnce(ready)
+      .mockResolvedValueOnce({ ...mint(), ...invalid })
+
+    await expect(createGrokBroker(owner, api).mint()).rejects.toThrow('Réponse de session Grok Voice invalide.')
+  })
+
+  it('sanitizes status and mint failures without logging or persisting their payloads', async () => {
+    const log = vi.spyOn(console, 'log')
+    const error = vi.spyOn(console, 'error')
+    const before = JSON.stringify(window.localStorage)
+    const api = vi.fn().mockRejectedValueOnce(new Error('private-secret raw-url'))
+    await expect(createGrokBroker(owner, api).mint()).rejects.toThrow('Grok Voice indisponible sur ce profil Hermes.')
+    api.mockResolvedValueOnce(ready).mockRejectedValueOnce(new Error('private-secret raw-url'))
+    await expect(createGrokBroker(owner, api).mint()).rejects.toThrow('Grok Voice indisponible sur ce profil Hermes.')
+    expect(log).not.toHaveBeenCalled()
+    expect(error).not.toHaveBeenCalled()
+    expect(JSON.stringify(window.localStorage)).toBe(before)
+  })
+})
