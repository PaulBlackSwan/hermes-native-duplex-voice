+  /** Only fixed categories and bounded numeric metadata reach desktop.log.
+   * Never pass an event, raw exception, identifier, transcript or token to console.
+   */
+  private diagnose(
+    event:
+      | 'handler_error'
+      | 'playback_backlog'
+      | 'transport_closed'
+      | 'transport_error'
+      | 'provider_error'
+      | 'untagged_delta'
+      | 'connect_timeout'
+      | 'task_submitting'
+      | 'task_admitted',
+    error?: unknown,
+    eventType?: unknown,
+    payloadChars?: unknown
+  ): void {
+    if (this.diagnosticBudget-- <= 0) {
+      return
+    }
