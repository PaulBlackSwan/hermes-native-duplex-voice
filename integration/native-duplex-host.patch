@@ -0,0 +1,120 @@
+import { useStore } from '@nanostores/react'
+import { useLayoutEffect, useRef, useState } from 'react'
+import { createPortal } from 'react-dom'
+
+import {
+  $nativeLiveCall,
+  endNativeLiveCall,
+  interruptNativeLiveTurn,
+  toggleNativeLiveMute
+} from '@/store/native-live-call'
+
+import { ConversationPill } from './controls'
+
+function visible(element: HTMLElement): boolean {
+  for (let node: HTMLElement | null = element; node; node = node.parentElement) {
+    if (node.hidden || node.inert || node.getAttribute('aria-hidden') === 'true') {
+      return false
+    }
+
+    const style = getComputedStyle(node)
+
+    if (style.display === 'none' || style.visibility === 'hidden') {
+      return false
+    }
+  }
+
+  return true
+}
+
+/** Presentation only: the captured runtime remains the authority for every action.
+ * Move into the top modal's DOM boundary, never defeat its focus/pointer guards. */
+export function NativeLiveControlsHost() {
+  const call = useStore($nativeLiveCall)
+  const fallback = useRef<HTMLDivElement>(null)
+  const [destination, setDestination] = useState<HTMLElement | null>(null)
+
+  useLayoutEffect(() => {
+    if (!call.active) {
+      setDestination(null)
+
+      return
+    }
+
+    const place = () => {
+      const dialogs = [...document.querySelectorAll<HTMLElement>('[role="dialog"], [role="alertdialog"]')].filter(
+        visible
+      )
+
+      const overlays = [...document.querySelectorAll<HTMLElement>('[data-overlay-surface]')].filter(visible)
+
+      const slot = [...document.querySelectorAll<HTMLElement>('[data-native-live-controls-slot]')].find(
+        node => node.dataset.nativeLiveControlsSlot === call.target && visible(node)
+      )
+
+      setDestination(dialogs.at(-1) ?? overlays.at(-1) ?? slot ?? fallback.current)
+    }
+
+    place()
+
+    const observer = new MutationObserver(records => {
+      // Meter bars update their inline styles frequently; they cannot change
+      // the placement and must not trigger document-wide visibility reads.
+      if (
+        records.every(
+          record => record.target instanceof Element && record.target.closest('[data-native-live-controls]')
+        )
+      ) {
+        return
+      }
+
+      place()
+    })
+
+    observer.observe(document.body, {
+      subtree: true,
+      childList: true,
+      attributes: true,
+      attributeFilter: ['hidden', 'inert', 'aria-hidden', 'style', 'class', 'data-state']
+    })
+
+    return () => observer.disconnect()
+  }, [call.active, call.target])
+
+  const docked = destination?.hasAttribute('data-native-live-controls-slot')
+  const modal = destination?.matches('[role="dialog"], [role="alertdialog"]')
+
+  return (
+    <>
+      <div ref={fallback} />
+      {call.active &&
+        destination &&
+        createPortal(
+          <div
+            className={
+              docked
+                ? undefined
+                : modal
+                  ? 'flex shrink-0 justify-end p-2'
+                  : 'fixed bottom-4 right-4 z-(--z-modal-popover) rounded-full bg-(--ui-chat-surface-background) p-2 shadow-nous [-webkit-app-region:no-drag]'
+            }
+            data-native-live-controls=""
+          >
+            <ConversationPill
+              active
+              disabled={false}
+              level={call.level}
+              muted={call.muted}
+              onEnd={() => endNativeLiveCall()}
+              onStart={() => {}}
+              onStopTurn={interruptNativeLiveTurn}
+              onToggleMute={toggleNativeLiveMute}
+              status={call.status === 'connecting' ? 'thinking' : call.status === 'error' ? 'idle' : call.status}
+              turnAction="interrupt-output"
+            />
+          </div>,
+          destination
+        )}
+    </>
+  )
+}
