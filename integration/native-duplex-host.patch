+const owner = { connectionId: 'local', profile: 'writer' }
+
+describe('native voice session ensure', () => {
+  it('shares the native create and publishes its adopted runtime without submitting a prompt or activating a profile', async () => {
+    const runtime = { current: null as string | null }
+    const stored = { current: null as string | null }
+    let finish!: (id: string) => void
+
+    const createSession = vi.fn(
+      () =>
+        new Promise<string>(resolve => {
+          finish = resolve
+        })
+    )
+
+    const resumeSession = vi.fn()
+    const { result } = renderHook(() => useEnsureVoiceSession({ runtime, stored, createSession, resumeSession }))
+    let first!: Promise<string | null>, second!: Promise<string | null>
+    act(() => {
+      first = result.current(owner)
+      second = result.current(owner)
+    })
+    expect(createSession).toHaveBeenCalledOnce()
+    await act(async () => finish('new-runtime'))
+    expect(await first).toBe('new-runtime')
+    expect(await second).toBe('new-runtime')
+    expect(resumeSession).not.toHaveBeenCalled()
+  })
+
+  it('adopts the selected canonical Bot Chat instead of creating a second conversation', async () => {
+    const runtime = { current: null as string | null }
+    const stored = { current: 'canonical-bot-chat' as string | null }
+    const createSession = vi.fn()
+
+    const resumeSession = vi.fn(async () => {
+      runtime.current = 'canonical-runtime'
+    })
+
+    const { result } = renderHook(() => useEnsureVoiceSession({ runtime, stored, createSession, resumeSession }))
+    expect(await result.current(owner)).toBe('canonical-runtime')
+    expect(resumeSession).toHaveBeenCalledWith('canonical-bot-chat', true, owner, { preserveActiveOwner: true })
+    expect(createSession).not.toHaveBeenCalled()
+  })
+
+  it('does not adopt a stale runtime left behind while the selected Bot Chat is loading', async () => {
+    const runtime = { current: 'previous-runtime' as string | null }
+    const stored = { current: 'canonical-bot-chat' as string | null }
+    const createSession = vi.fn()
+
+    const resumeSession = vi.fn(async () => {
+      runtime.current = 'canonical-runtime'
+    })
+
+    const { result } = renderHook(() => useEnsureVoiceSession({ runtime, stored, createSession, resumeSession }))
+    expect(await result.current(owner)).toBe('canonical-runtime')
+    expect(createSession).not.toHaveBeenCalled()
+  })
+
+  it('refuses a stale fresh-chat owner instead of changing the active profile to route it', async () => {
+    const createSession = vi.fn()
+
+    const { result } = renderHook(() =>
+      useEnsureVoiceSession({
+        runtime: { current: null },
+        stored: { current: null },
+        createSession,
+        resumeSession: vi.fn()
+      })
+    )
+
+    await expect(result.current({ connectionId: 'other', profile: 'writer' })).rejects.toThrow(/owner/i)
+    expect(createSession).not.toHaveBeenCalled()
+  })
+})
