+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { readDesktopLiveProvider, writeDesktopLiveProvider } from '@/lib/voice-live-preference'
+
+beforeEach(() => {
+  window.localStorage.clear()
+  vi.resetModules()
+})
+
+describe('Desktop live provider profile lifecycle', () => {
+  it('migrates local preference with tiles without moving a remote same-name owner', async () => {
+    const local = { connectionId: 'local', profile: 'old' }
+    const remote = { connectionId: 'remote', profile: 'old' }
+    writeDesktopLiveProvider(local, 'xai-oauth')
+    writeDesktopLiveProvider(remote, 'xai-oauth')
+    const { migrateTilesForProfile } = await import('./session-states')
+    migrateTilesForProfile('old', 'renamed')
+    expect(readDesktopLiveProvider({ ...local, profile: 'renamed' })).toBe('xai-oauth')
+    expect(readDesktopLiveProvider(local)).toBe('openai')
+    expect(readDesktopLiveProvider(remote)).toBe('xai-oauth')
+  })
+
+  it('drops the exact routed owner preference when its profile is deleted', async () => {
+    const local = { connectionId: 'local', profile: 'same' }
+    const remote = { connectionId: 'remote', profile: 'same' }
+    writeDesktopLiveProvider(local, 'xai-oauth')
+    writeDesktopLiveProvider(remote, 'xai-oauth')
+    const { dropTilesForProfile } = await import('./session-states')
+    dropTilesForProfile('same', { connectionId: 'remote', profile: 'same' })
+    expect(readDesktopLiveProvider(remote)).toBe('openai')
+    expect(readDesktopLiveProvider(local)).toBe('xai-oauth')
+  })
+})
