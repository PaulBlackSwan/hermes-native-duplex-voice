--- /dev/null
+++ b/apps/desktop/src/store/native-live-providers.ts
@@ -0,0 +1,51 @@
+import { atom } from 'nanostores'
+
+import type { NativeLiveBridge, NativeLiveHandlers, NativeLiveVoiceProvider } from '@/sdk/native-live-voice'
+
+interface RegisteredProvider extends NativeLiveVoiceProvider {
+  source: string
+}
+
+/** Registration supplies transport only. Backend availability and native controls remain core-owned. */
+export const $nativeLiveProviders = atom<Readonly<Record<string, RegisteredProvider>>>({})
+
+export function registerNativeLiveProvider(source: string, provider: NativeLiveVoiceProvider): () => void {
+  if (provider.apiVersion !== 1) {
+    throw new Error('Unsupported native live voice API version')
+  }
+
+  if (
+    !/^[a-z][a-z0-9-]{0,63}$/.test(provider.id) ||
+    provider.id === 'openai' ||
+    typeof provider.createSession !== 'function'
+  ) {
+    throw new Error('Invalid native live voice provider')
+  }
+
+  if ($nativeLiveProviders.get()[provider.id]) {
+    throw new Error('Native live voice provider already registered')
+  }
+
+  const entry = Object.freeze({ ...provider, source })
+  $nativeLiveProviders.set({ ...$nativeLiveProviders.get(), [provider.id]: entry })
+
+  return () => {
+    if ($nativeLiveProviders.get()[entry.id] !== entry) {
+      return
+    }
+
+    const next = { ...$nativeLiveProviders.get() }
+    delete next[entry.id]
+    $nativeLiveProviders.set(next)
+  }
+}
+
+export function createNativeLiveSession(id: string, bridge: NativeLiveBridge, handlers: NativeLiveHandlers) {
+  const provider = $nativeLiveProviders.get()[id]
+
+  if (!provider) {
+    throw new Error('Native live voice provider unavailable')
+  }
+
+  return provider.createSession(bridge, handlers)
+}
