@@ -0,0 +1,78 @@
+import type { GatewayEvent } from '@hermes/shared'
+
+import type { HermesGateway } from '@/hermes'
+
+interface NativePoolIdentity {
+  primaryGateway: HermesGateway | null
+  primaryConnectionId: string | null
+  primaryProfile: string
+  secondaries: ReadonlyMap<string, { gateway: HermesGateway | null }>
+}
+
+/** Snapshot pool provenance; foreground selection is deliberately not part of ownership. */
+export function nativeGatewayOwnership(
+  pool: NativePoolIdentity,
+  gateway: HermesGateway | null,
+  scope: string,
+  primary: boolean
+) {
+  const connectionId = pool.primaryConnectionId
+  const profile = pool.primaryProfile
+  const entry = pool.secondaries.get(scope)
+
+  return () =>
+    primary
+      ? pool.primaryGateway === gateway && pool.primaryConnectionId === connectionId && pool.primaryProfile === profile
+      : pool.secondaries.get(scope) === entry && entry?.gateway === gateway
+}
+
+/** A call owns one dial, not a reconnectable route. Never revive after a disconnect. */
+export function captureNativeGateway(
+  gateway: HermesGateway | null,
+  profile: string,
+  releaseRoute: () => void,
+  ownsSocket: () => boolean
+) {
+  if (!gateway || gateway.connectionState !== 'open') {
+    releaseRoute()
+    throw new Error('Native gateway is closed')
+  }
+
+  let invalid = false
+  let released = false
+
+  const off = gateway.onState(state => {
+    if (state !== 'open') {
+      invalid = true
+    }
+  })
+
+  const isCurrent = () => !invalid && !released && ownsSocket() && gateway.connectionState === 'open'
+
+  return {
+    isCurrent,
+    onState: gateway.onState.bind(gateway),
+    onEvent: (listener: (event: GatewayEvent) => void) =>
+      gateway.onEvent(event => {
+        if (isCurrent()) {
+          listener(event)
+        }
+      }),
+    async request(method: string, params: Record<string, unknown>) {
+      if (!isCurrent()) {
+        throw new Error('Native gateway changed or closed')
+      }
+
+      return gateway.request(method, { ...params, profile })
+    },
+    release() {
+      if (released) {
+        return
+      }
+
+      released = true
+      off()
+      releaseRoute()
+    }
+  }
+}
