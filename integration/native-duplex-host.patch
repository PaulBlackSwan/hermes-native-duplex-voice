+/** Device-local preference, never a backend configuration or credential. */
+export function readDesktopLiveProvider(owner: ResolvedOwner): LiveVoiceProvider {
+  return readJson<Record<string, unknown>>(KEY)?.[keyFor(owner)] === 'xai-oauth' ? 'xai-oauth' : 'openai'
+}
+
+export function writeDesktopLiveProvider(owner: ResolvedOwner, provider: LiveVoiceProvider): void {
+  writeJson(KEY, { ...readJson<Record<string, unknown>>(KEY), [keyFor(owner)]: provider })
+}
+
+export function dropDesktopLiveProvider(owner: ResolvedOwner): void {
+  const values = { ...readJson<Record<string, unknown>>(KEY) }
+  delete values[keyFor(owner)]
+  writeJson(KEY, values)
+}
+
+/** Local profile renames do not rename same-named profiles on other hosts. */
+export function migrateDesktopLiveProvider(oldProfile: string, newProfile: string): void {
+  const values = { ...readJson<Record<string, unknown>>(KEY) }
+
+  for (const connectionId of ['local', null]) {
+    const from = keyFor({ connectionId, profile: oldProfile })
+    const to = keyFor({ connectionId, profile: newProfile })
+
+    if (values[from] !== undefined) {
+      values[to] ??= values[from]
+      delete values[from]
+    }
+  }
+
+  writeJson(KEY, values)
+}
