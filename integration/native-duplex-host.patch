@@ -0,0 +1,146 @@
+import { useStore } from '@nanostores/react'
+import { useCallback, useEffect, useRef } from 'react'
+
+import { resolveOwnerNow } from '@/api/client'
+import { resolveVoiceDraftOwner } from '@/app/session/hooks/use-ensure-voice-session'
+import { activeGatewayConnectionId, activeGatewayProfileKey } from '@/store/gateway'
+import {
+  $nativeLiveCall,
+  endNativeLiveCall,
+  interruptNativeLiveTurn,
+  startNativeLiveCall,
+  toggleNativeLiveMute
+} from '@/store/native-live-call'
+
+import { useComposerScope } from '../scope'
+
+import type { ConversationStatus } from './use-voice-conversation'
+
+interface VoiceGrokConversationOptions {
+  enabled: boolean
+  sessionId: string | null | undefined
+  onEnsureSession?: (owner: { connectionId: string | null; profile: string }) => Promise<string | null>
+  beforeMicOpen?: () => Promise<void> | void
+  onFatalError?: () => void
+  onClosed?: () => void
+}
+
+/** A native view of the window-owned plugin call. Unmount only unsubscribes the view. */
+export function useVoiceGrokConversation(options: VoiceGrokConversationOptions) {
+  const scope = useComposerScope()
+  const resolved = resolveOwnerNow(scope)
+
+  const owner =
+    scope.target === 'main' && !options.sessionId
+      ? resolveVoiceDraftOwner()
+      : {
+          connectionId: resolved.connectionId ?? activeGatewayConnectionId(),
+          profile: resolved.profile ?? activeGatewayProfileKey()
+        }
+
+  const state = useStore($nativeLiveCall)
+
+  // The runtime fences its captured socket/owner and the active main session.
+  // Adopting a draft must not re-home that call to an ambient profile here.
+  const sameSession = !options.sessionId || !state.scope?.sessionId || state.scope.sessionId === options.sessionId
+
+  const sameOwner =
+    state.scope?.owner.connectionId === owner.connectionId && state.scope?.owner.profile === owner.profile
+
+  const belongs = state.target === scope.target && sameSession && (scope.target === 'main' || sameOwner)
+
+  const active = state.active && belongs
+  const latest = useRef({ options, owner, target: scope.target })
+  latest.current = { options, owner, target: scope.target }
+  const attached = useRef(false)
+  attached.current = active
+  const mounted = useRef(true)
+  // eslint-disable-next-line no-restricted-syntax -- lifecycle token, not a mirror of reactive state
+  useEffect(() => {
+    mounted.current = true
+
+    return () => {
+      mounted.current = false
+    }
+  }, [])
+
+  const start = useCallback(async () => {
+    const captured = latest.current
+    const sequence = $nativeLiveCall.get().closeSequence
+    await startNativeLiveCall({ ...captured.options, owner: captured.owner, target: captured.target })
+    const after = $nativeLiveCall.get()
+
+    if (mounted.current && !after.active && after.closeSequence === sequence) {
+      latest.current.options.onFatalError?.()
+    }
+  }, [])
+
+  useEffect(() => {
+    if (options.enabled) {
+      void start()
+    }
+  }, [options.enabled, start])
+
+  useEffect(
+    () =>
+      $nativeLiveCall.listen((next, previous) => {
+        if (next.closeSequence === previous.closeSequence) {
+          return
+        }
+
+        const view = latest.current
+
+        if (
+          (view.target === 'main' ||
+            (next.scope?.owner.connectionId === view.owner.connectionId &&
+              next.scope?.owner.profile === view.owner.profile)) &&
+          next.target === view.target &&
+          (!view.options.sessionId || next.scope?.sessionId === view.options.sessionId)
+        ) {
+          view.options.onClosed?.()
+
+          if (next.closeReason !== 'hangup') {
+            view.options.onFatalError?.()
+          }
+        }
+      }),
+    []
+  )
+
+  const end = useCallback(async () => {
+    if (attached.current) {
+      endNativeLiveCall()
+    }
+  }, [])
+
+  const toggleMute = useCallback(() => {
+    if (attached.current) {
+      toggleNativeLiveMute()
+    }
+  }, [])
+
+  const stopTurn = useCallback(() => {
+    if (attached.current) {
+      interruptNativeLiveTurn()
+    }
+  }, [])
+
+  const status: ConversationStatus = !active
+    ? 'idle'
+    : state.status === 'connecting'
+      ? 'thinking'
+      : state.status === 'error'
+        ? 'idle'
+        : state.status
+
+  return {
+    active,
+    end,
+    level: active ? state.level : 0,
+    muted: active && state.muted,
+    start,
+    status,
+    stopTurn,
+    toggleMute
+  }
+}
