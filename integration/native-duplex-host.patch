+import { $nativeLiveProviders, createNativeLiveSession } from './native-live-providers'
+import { notify } from './notifications'
+
+export interface NativeLiveCallState {
+  active: boolean
+  scope: NativeLiveScope | null
+  target: string
+  status: NativeLiveStatus
+  muted: boolean
+  level: number
+  closeSequence: number
+  closeReason: string | null
+}
+
+const initial: NativeLiveCallState = {
+  active: false,
+  scope: null,
+  target: '',
+  status: 'idle',
+  muted: false,
+  level: 0,
+  closeSequence: 0,
+  closeReason: null
+}
+
+export const $nativeLiveCall = atom<NativeLiveCallState>(initial)
+
+interface StartOptions {
+  owner: NativeLiveOwner
+  sessionId?: string | null
+  target: string
+  onEnsureSession?: (owner: { connectionId: string | null; profile: string }) => Promise<string | null>
+  beforeMicOpen?: () => Promise<void> | void
+}
+interface Call {
+  options: StartOptions
+  scope: NativeLiveScope
+  /** Explicit voice-account scope, independent of the delegated chat's owner. */
+  brokerOwner: NativeLiveOwner
+  session?: NativeLiveSession
+  gateway?: Awaited<ReturnType<typeof captureGatewayForAgent>>
+  cleanup: Array<() => void>
+  wakeBarrier?: Promise<unknown>
+  indicatorOwned?: boolean
+  provider: NonNullable<ReturnType<typeof $nativeLiveProviders.get>['xai-oauth']>
+}
+let current: Call | null = null
+
+const sameOwner = (a: NativeLiveOwner, b: NativeLiveOwner) =>
+  a.connectionId === b.connectionId && a.profile === b.profile
+
+function valid(call: Call): boolean {
+  if (current !== call || !call.gateway?.isCurrent()) {
+    return false
