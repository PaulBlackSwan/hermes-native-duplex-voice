+      close() {}
+    }
+    vi.stubGlobal('WebSocket', SocketFixture)
+    vi.stubGlobal('AudioContext', AudioContextFixture)
+    vi.stubGlobal('AudioWorkletNode', WorkletFixture)
+    vi.stubGlobal('navigator', {
+      mediaDevices: { getUserMedia: async () => ({ getTracks: () => [track], getAudioTracks: () => [track] }) }
+    })
+    vi.stubGlobal('fetch', () => {
+      throw new Error('Provider network forbidden')
+    })
+    const { default: plugin } = createRequire(import.meta.url)(process.env.GROK_NATIVE_PLUGIN_ARTIFACT!)
+
+    let dispose = () => {}
+
+    const register = vi.fn((value: any) => {
+      dispose = registerNativeLiveProvider('plugin:wire-fixture', value)
+    })
+
+    plugin.register({ registerLiveVoiceProvider: register })
+    expect(register).toHaveBeenCalledOnce()
+    let session: ReturnType<typeof createNativeLiveSession> | undefined
+
+    try {
+      await h.client.connect(h.dial())
+      const captured = captureNativeGateway(h.client, owner.profile, vi.fn(), () => true)
+
+      const bridge = createGrokBridge({
+        owner,
+        request: captured.request,
+        rest: async ({ method }) =>
+          method === 'GET'
+            ? { ok: true, available: true, model: 'grok-voice-latest', voice: 'eve', message: null }
+            : {
+                ok: true,
+                url: 'wss://api.x.ai/v1/realtime?model=grok-voice-latest',
+                protocol_prefix: 'xai-client-secret.',
+                client_secret: { value: 'synthetic-fixture', expires_at: Date.now() / 1000 + 60 },
+                session: {
+                  voice: 'eve',
+                  instructions: 'Fixture instructions',
+                  tools: [
+                    {
+                      type: 'function',
+                      name: 'hermes_task',
+                      parameters: {
+                        type: 'object',
+                        properties: { request: { type: 'string' } },
+                        required: ['request'],
+                        additionalProperties: false
+                      }
+                    },
+                    {
+                      type: 'function',
+                      name: 'end_call',
+                      parameters: { type: 'object', properties: {}, additionalProperties: false }
+                    }
+                  ],
+                  reasoning: { effort: 'none' },
+                  turn_detection: { type: 'server_vad' },
+                  audio: {
+                    input: { format: { type: 'audio/pcm', rate: 24000 } },
+                    output: { format: { type: 'audio/pcm', rate: 24000 } }
+                  }
+                }
+              },
+        subscribe: captured.onEvent as never,
+        isCurrent: captured.isCurrent,
+        isBusy: async () => false
+      })
+
+      session = createNativeLiveSession('xai-oauth', bridge, { onError: vi.fn(), onClosed: vi.fn() })
+      session.setMuted(true)
+      await session.start(scope)
+      provider.onopen()
+      expect(sent[0]).toMatchObject({ type: 'session.update', session: { model: 'grok-voice-latest', voice: 'eve' } })
+
+      const event = async (value: object) => {
+        provider.onmessage({ data: JSON.stringify(value) })
+        await tick()
+      }
+
+      await event({ type: 'session.updated' })
+      expect(track.enabled).toBe(false)
+      worklet.port.onmessage({ data: new Float32Array(2400).fill(0.5) })
+      expect(sent.some(frame => frame.type === 'input_audio_buffer.append')).toBe(false)
+      await event({
+        type: 'response.function_call_arguments.done',
+        name: 'hermes_task',
+        call_id: 'voice-task',
+        arguments: '{"request":"work"}'
+      })
+      await vi.waitFor(() => expect(sent.some(frame => frame.item?.type === 'function_call_output')).toBe(true))
+      const ack = JSON.parse(sent.find(frame => frame.item?.type === 'function_call_output').item.output)
+      expect(ack).toMatchObject({ ok: true, receipt: 'queued', note: expect.stringMatching(/chat/) })
+      h.complete()
+      await new Promise(resolve => setTimeout(resolve, 20))
+      await event({ type: 'response.done' })
+      await vi.waitFor(() => expect(JSON.stringify(sent)).toContain('canonical task completed'))
+      session.end('hangup')
+      expect(h.frames.filter(frame => frame.method === 'prompt.submit')).toHaveLength(1)
+      expect(
+        h.frames.some(frame => ['session.interrupt', 'prompt.cancel', 'session.close'].includes(frame.method))
+      ).toBe(false)
+      captured.release()
+      expect(h.client.connectionState).toBe('open')
+    } finally {
+      session?.end('hangup')
+      dispose()
+      await h.close()
+    }
+  }
+)
